rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check user role (trim whitespace)
    function hasRole(userId, role) {
      let userRole = get(/databases/$(database)/documents/users/$(userId)).data.role;
      return userRole == role || userRole.trim() == role;
    }

    // Users collection - role-based access
    match /users/{userId} {
      allow read: if request.auth.uid == userId;
      allow update: if request.auth.uid == userId;
      allow read, write: if hasRole(request.auth.uid, 'admin');
      allow create: if request.auth.uid != null;
    }

    // Notifications collection - ADMINS CAN READ/WRITE, USERS CAN READ
    match /notifications/{document=**} {
      allow read, write, create, delete: if hasRole(request.auth.uid, 'admin');
      allow read: if request.auth.uid != null;
    }

    // Projects collection
    match /projects/{document=**} {
      allow read: if true;
      allow write: if hasRole(request.auth.uid, 'admin');
    }

    // Activities collection
    match /activities/{document=**} {
      allow read: if true;
      allow write: if hasRole(request.auth.uid, 'admin');
    }

    // Gallery collection
    match /gallery/{document=**} {
      allow read: if true;
      allow write: if hasRole(request.auth.uid, 'admin');
    }

    // Field visits
    match /fieldVisits/{visitId} {
      allow read: if request.auth.uid == resource.data.userId || hasRole(request.auth.uid, 'admin');
      allow create: if request.auth.uid != null;
      allow update, delete: if request.auth.uid == resource.data.userId || hasRole(request.auth.uid, 'admin');
    }

    // Participations
    match /participations/{participationId} {
      allow read: if request.auth.uid == resource.data.userId || hasRole(request.auth.uid, 'admin');
      allow create: if request.auth.uid != null;
      allow update, delete: if request.auth.uid == resource.data.userId || hasRole(request.auth.uid, 'admin');
    }

    // Contact form submissions
    match /contact_us/{document=**} {
      allow create: if true;
      allow read, delete: if hasRole(request.auth.uid, 'admin');
    }

    // GRINOVA registrations - allow anyone to create, admins to read/delete
    match /Grinova/{document=**} {
      allow create: if true;
      allow read, delete: if hasRole(request.auth.uid, 'admin');
    }

    // Team
    match /team/{document=**} {
      allow read: if true;
      allow write: if hasRole(request.auth.uid, 'admin');
    }
  }
}
